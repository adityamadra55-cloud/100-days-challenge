/*Q22: Write a program to find profit or loss percentage given cost price and selling price.
Sample Test Cases:
Input 1:
1000 1200
Output 1:
Profit 20%

Input 2:
1000 800
Output 2:
Loss 20%

Input 3:
1000 1000
Output 3:
No Profit No Loss
*/
#include<stdio.h>
#include<math.h>
int main()
{
    int CP, SP, Profit, Loss, Profitpercentage, Losspercentage;
    printf("Enter Cost Price:\n");
    scanf("%d", &CP);
    printf("Enter Selling Price:");
    scanf("%d", &SP);
    Profit = SP - CP;
    Loss = CP - SP;
    Profitpercentage = (Profit*100)/CP;
    Losspercentage = (Loss*100)/CP;
    if (SP>CP)
    {
        printf("Profit percentage = %d", Profitpercentage);
    }    
    else 
    {
        printf("Loss percentage = %d", Losspercentage);
    }
    return 0;
}
