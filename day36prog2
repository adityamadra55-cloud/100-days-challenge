#include<stdio.h>
int main()
{
    int arr[3][3];
    int a, b, sum = 0;
    printf("Enter elements:");
    for (a = 0; a<3; a++)
    {
        for (b = 0; b<3; b++)
        {
            scanf("%d", &arr[a][b]);
        }
    }
    for (a = 0; a<3; a++)
    {
        for (b = 0; b<3; b++)
        {
            printf("%d\t", arr[a][b]);
        }
        printf("\n");
    }
    for (a = 0; a<3; a++)
    {
        for (b = 0; b<3; b++)
        {
            sum = sum + arr[a][b];
        }
    
    }
    printf("Sum of all elements = %d", sum);
    return 0;
}
