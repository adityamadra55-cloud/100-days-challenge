#include <stdio.h>

int main()
{
    char str[100];
    int i;

    printf("Enter full name: ");
    gets(str);

    for(i = 0; str[i] != '\0'; i++)
    {
        if(i == 0)
        {
            printf("%c.", str[i]);
        }

        if(str[i] == ' ' && str[i+1] != '\0')
        {
            if(str[i+1] == ' ')
                continue;

            if(str[i+1] != '\0')
            {
                int j = i + 1;
                while(str[j] != ' ' && str[j] != '\0')
                    j++;

                if(str[j] == '\0')
                    printf(" %s", &str[i+1]);
                else
                    printf("%c.", str[i+1]);
            }
        }
    }

    return 0;
}
