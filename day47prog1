#include <stdio.h>
#include <string.h>

int main()
{
    char a[100], b[100];
    int i, count[256] = {0};

    printf("Enter first string: ");
    scanf("%s", a);

    printf("Enter second string: ");
    scanf("%s", b);

    if(strlen(a) != strlen(b))
    {
        printf("Not anagrams");
    }
    else
    {
        for(i = 0; a[i] != '\0'; i++)
        {
            count[a[i]]++;
            count[b[i]]--;
        }

        for(i = 0; i < 256; i++)
        {
            if(count[i] != 0)
                break;
        }

        if(i == 256)
            printf("Anagrams");
        else
            printf("Not anagrams");
    }

    return 0;
}
