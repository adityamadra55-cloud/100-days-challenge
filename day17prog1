/*Q33: Write a program to check if a number is an Armstrong number.

Sample Test Cases:
Input 1:
153
Output 1:
Armstrong

Input 2:
123
Output 2:
Not Armstrong

*/
#include <stdio.h>

int main()
{
    int n, original, rem, sum = 0, count = 0;
    int power, temp;

    printf("Enter any number: ");
    scanf("%d", &n);

    original = n;
    temp = n;

    while (temp != 0)
    {
        count++;
        temp = temp / 10;
    }

    temp = n;

    while (temp != 0)
    {
        rem = temp % 10;
        power = 1;

        for (int i = 1; i <= count; i++)
        {
            power = power * rem;
        }

        sum = sum + power;
        temp = temp / 10;
    }

    if (sum == original)
        printf("Armstrong");
    else
        printf("Not Armstrong");

    return 0;
}
