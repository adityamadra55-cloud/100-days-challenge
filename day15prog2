/*Q30: Write a program to reverse a given number.
Sample Test Cases:
Input 1:
1234
Output 1:
4321

Input 2:
100
Output 2:
1
*/
#include<stdio.h>
int main(void)
{
    int n, original, rem, reverse;
    reverse = 0;
    original = n;
    printf("Enter any no.");
    scanf("%d", &n);
    while (n!=0)
    {
        rem = n%10;
        n = n/10;
        reverse = (reverse*10)+rem;
    }
    printf("Reverse = %d", reverse, original);
    return 0;
}
