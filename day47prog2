#include <stdio.h>
#include <string.h>

int main()
{
    char str[100], word[100], longest[100];
    int i, j, max = 0;

    printf("Enter a sentence: ");
    gets(str);

    for(i = 0; str[i] != '\0'; i++)
    {
        j = 0;

        while(str[i] != ' ' && str[i] != '\0')
        {
            word[j] = str[i];
            j++;
            i++;
        }

        word[j] = '\0';

        if(j > max)
        {
            max = j;
            strcpy(longest, word);
        }
    }

    printf("Longest word: %s", longest);

    return 0;
}
