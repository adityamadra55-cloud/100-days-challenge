#include <stdio.h>

int main()
{
    int n, k, i, j;
    int a[100], temp[100];

    printf("Enter size of array: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    printf("Enter number of rotations: ");
    scanf("%d", &k);

    k = k % n;

    for(i = 0; i < n; i++)
    {
        j = (i + k) % n;
        temp[j] = a[i];
    }

    printf("Rotated array: ");
    for(i = 0; i < n; i++)
    {
        printf("%d ", temp[i]);
    }

    return 0;
}
