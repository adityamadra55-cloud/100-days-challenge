/*Q28: Write a program to print the product of even numbers from 1 to n.
Sample Test Cases:
Input 1:
4
Output 1:
8 (2 * 4)

Input 2:
6
Output 2:
48 (2 * 4 * 6)
*/
#include<stdio.h>
int main(void)
{
    int n;
    printf("Enter the value of n:");
    scanf("%d", &n);
    int product = 1;
    for (int i = 1; i<=n; i++)
    {
        if (i%2 == 0)
        {
            product = (product * i);
        }
    } 
    printf("Product = %d", product);
    return 0;
}
    
