/*Q41: Write a program to swap the first and last digit of a number.


Sample Test Cases:
Input 1:
1234
Output 1:
4231

Input 2:
1001
Output 2:
1001

*/
#include <stdio.h>

int main()
{
    int n, temp, first, last, count = 0;
    int divisor = 1, middle, result;

    printf("Enter any number: ");
    scanf("%d", &n);

    temp = n;
    last = n % 10;

    while (temp >= 10)
    {
        temp = temp / 10;
        count++;
    }

    first = temp;

    for (int i = 1; i <= count; i++)
    {
        divisor = divisor * 10;
    }

    middle = (n % divisor) / 10;

    result = last * divisor + middle * 10 + first;

    printf("%d", result);

    return 0;
}
