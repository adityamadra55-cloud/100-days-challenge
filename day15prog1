/*Q29: Write a program to calculate the factorial of a number.
Sample Test Cases:
Input 1:
5
Output 1:
120

Input 2:
3
Output 2:
6
*/
#include<stdio.h>
int main(void)
{
    int n, factorial, i;
    printf("Enter the value of n:");
    scanf("%d", &n);
    factorial = 1;
    i = 1;
    while (i<=n)
    {
        factorial = (factorial * i);
        i++;
    }
    printf("Factorial of the given integer = %d", factorial);
    return 0;
}
